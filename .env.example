# ==========================================
# 네이버 이메일 발송 설정 (.env)
# ==========================================
# 1. 네이버 아이디 (뒤의 @naver.com 제외)
NAVER_USER=

# 2. 네이버 비밀번호 (2단계 인증 사용 시 네이버 보안설정 > 등록/설정 > 애플리케이션 비밀번호 생성값 입력)
NAVER_PASSWORD=

# 3. 브리핑을 받을 이메일 주소 (비워두면 네이버 계정 본인 메일로 자동 발송)
RECEIVER_EMAIL=
