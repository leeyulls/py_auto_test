# ==============================================================================
# Streamlit Cloud App Settings > Secrets 설정 가이드 템플릿
# ==============================================================================
# 이 파일은 참고용 예시입니다. 실제 값은 Streamlit Cloud 대시보드의
# [App settings] > [Secrets] 화면에 붙여넣어 안전하게 관리하세요.
# (이 파일에는 절대 실제 비밀번호나 API 키를 적지 마세요)
# ==============================================================================

# 1. 백업 보안 PIN (미설정 시 기본 8390 작동)
DASHBOARD_PASSWORD = "8390"

# 2. 구글 로그인 접근 허용 화이트리스트 (쉼표로 구분하여 등록)
# 오직 여기에 등록된 Google 계정만 대시보드를 열람할 수 있습니다.
ALLOWED_GOOGLE_EMAILS = "feelriyou@gmail.com"

# 3. Google Cloud OAuth 2.0 연동 설정 (Google Cloud Console 발급)
# [auth]
# redirect_uri = "https://leeyulls-py-auto-test-dashboard-n9oqeo.streamlit.app/oauth2callback"
# cookie_secret = "RANDOM_SECURE_SECRET_STRING_AT_LEAST_32_CHARS"
# client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
# client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
